# Agent QA PoC runtime configuration — copy to runtime/.env (gitignored)
ANTHROPIC_API_KEY=
# Handoff: where a compiled work order goes. Leave AGENTQA_HANDOFF_URL empty and
# work orders are written as JSON files under AGENTQA_HANDOFF_DIR (the default).
# Set it to POST the same JSON payload to a generic webhook instead.
AGENTQA_HANDOFF_URL=
# Optional bearer token for that webhook (redacted from traces)
AGENTQA_HANDOFF_TOKEN=
# Where the file sink writes work orders (default: <runs dir>/handoffs)
AGENTQA_HANDOFF_DIR=
# Comma-separated publication/target names offered in the UI's handoff selector
AGENTQA_HANDOFF_TARGETS=
AGENTQA_MODEL=claude-sonnet-5
# Per-run token budget (input+output). ~1M ≈ a couple of dollars on Sonnet with caching.
AGENTQA_MAX_TOKENS=1000000
# Comma-separated hosts the agent may act on (guardrail v1)
AGENTQA_ALLOWED_HOSTS=app.example.com
